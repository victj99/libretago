{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start-spring-boot-debug",
            "type": "shell",
            "command": "./mvnw spring-boot:run -Dspring-boot.run.jvmArguments='-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005'",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Listening for transport dt_socket at address: 5005.*",
                    "endsPattern": ".*Started LibretagoApplication.*"
                }
            }
        },
        {
            "label": "stop-spring-boot-debug",
            "type": "shell",
            "command": "kill $(lsof -t -i:5005)"
        }
    ]
}